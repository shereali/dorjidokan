# Copy to .env on the server ONLY (never commit the real .env).
#   cp .env.example .env && chmod 600 .env
# Generate real values with:
#   openssl rand -base64 32   (APP_KEY)
#   openssl rand -hex 24      (DB_PASSWORD / DB_ROOT_PASSWORD)
#
# APP_KEY is generated by `php artisan key:generate` on first deploy.

APP_NAME=Dorjidokan
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://dorjidokan.softcredible.com
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database — generated fresh on first deploy
DB_CONNECTION=mysql
DB_HOST=dorjidokan-db-1
DB_PORT=3306
DB_DATABASE=dorjidokan
DB_USERNAME=dorjidokan
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Session / cache / queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail — set a real SMTP provider in production
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@dorjidokan.softcredible.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS / notification gateway (log = dev, http|twilio|clicksend|custom = production)
SMS_PROVIDER=log
SMS_GATEWAY=custom
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
SMS_AUTH=basic
SMS_FIELD_TO=to
SMS_FIELD_FROM=from
SMS_FIELD_TEXT=text

# Stripe billing (Cashier)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
FRONTEND_URL=https://dorjidokan.softcredible.com
FRONTEND_URLS=https://dorjidokan.softcredible.com
SANCTUM_STATEFUL_DOMAINS=dorjidokan.softcredible.com

# Reverb (WebSockets) — point at your deployment if you expose one
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=dorjidokan.softcredible.com
REVERB_PORT=443
REVERB_SCHEME=https

# Frontend public runtime values (non-secret, baked into the browser bundle)
NUXT_PUBLIC_API_BASE=https://dorjidokan.softcredible.com/api/v1
NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=dorjidokan.softcredible.com
NUXT_PUBLIC_REVERB_PORT=443
NUXT_PUBLIC_REVERB_SCHEME=https

# First-run admin (optional — only used if seeding an admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=
